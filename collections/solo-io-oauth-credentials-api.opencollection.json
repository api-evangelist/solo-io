{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portal Backend OAUTH Credentials API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "oauth-credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get app OAuth credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/apps/:appID/oauth-credentials",
            "params": [
              {
                "name": "appID",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the OAuth credential for an application (without the client secret)"
        },
        {
          "info": {
            "name": "Create app OAuth credential",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/apps/:appID/oauth-credentials",
            "params": [
              {
                "name": "appID",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new OAuth credential for an application. The client secret is only returned once at creation time."
        },
        {
          "info": {
            "name": "Delete OAuth credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/oauth-credentials/:credentialID",
            "params": [
              {
                "name": "credentialID",
                "value": "",
                "type": "path",
                "description": "OAuth Credential ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes an OAuth credential by ID"
        }
      ]
    }
  ],
  "bundled": true
}