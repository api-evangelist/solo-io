{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portal Backend Users API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the authenticated user's information. Creates a new user record if this is the first access."
        },
        {
          "info": {
            "name": "Update current user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/v1/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the authenticated user's information"
        },
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/users",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of all registered users"
        }
      ]
    }
  ],
  "bundled": true
}